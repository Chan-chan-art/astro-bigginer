---
import Layout from "../layouts/Layout.astro"
import Button from "../component/button/Button.astro"
const formLink = "/"
---

<div class="bg-[#24341C] py-1">
  <div class="w-full text-9xl lg:text-[200pt] heading orange text-center">PETIPOIS</div>
  <div class="flex p-4">
  <div>
    <img src="../images/img1.avif" alt="Profile Picture" class="rounded-2-full rounded-t-full rounded-bl-full  w-32 object-cover h-32 border border-white border-2" />
</div>
<div class="p-4 text-white">
  <h1 class="w-full text-2xl font-bold">DESIGNER. DEVELOPER. WRITER</h1>
  <h2 class="max-w-lg text-lg">
    I specialize in custom software development and search engine optomizatio (SEO)
  </h2>
  <div class="pt-4"><Button href="{formLink}" class="orange-btn uppercase">Work With Me</Button></div>
</div>
</div>
 </div> 
 <Layout />
