---
import { getCollection } from "astro:content";
import { Badge } from "../component/badge";
import Button from "../component/button/Button.astro"
const allProjects = await getCollection("projects");
import ProjectCard from "../component/ProjectCard.astro";

---

<div class="bg-[#24361C] p-8">
  {
  allProjects.map((project: any ) => (
     <ProjectCard project={project} buttonText="View Article">
    
      
     <div class="grid grid-cols-3 gap-4">
      {project.data.tech.map((item: any) => (
        <Badge variant="info">
          <h3 class="p-2 text-center text-sm">{item}</h3></Badge>
      ))}
      </div>
    </ProjectCard>
  
  ))
  }
  <Button size="lg" href="/" class="uppercase text-2xl orange heading">More Projects</Button>
  </div>