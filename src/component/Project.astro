---
import { getCollection, render} from "astro:content";
import Button from "../component/button/Button.astro"
import ProjectCard from "../component/ProjectCard.astro";
import Heading from "../component/Heading.astro"

const allProjects = await getCollection("projects");
---

<div class="p-8 bg-[#24361C]">
<div>
  <Heading text="Recent Projects" />

{
  allProjects.map(async (project) => {
    const { Content } = await render(project);
    return (
     <ProjectCard project={project}>
          <Content />
      </ProjectCard > 
    );
  })
}

<Button size="lg" href="/" class="p-24 w-full border border-1 border orange-100 bg-transparent hover:text-black uppercase text-9xl orange heading">More Projects</Button>
</div>
</div>



  
