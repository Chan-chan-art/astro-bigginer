---
//import { Card, CardContent, CardDescription, CardFooter, CardHeader, CardTitle } from "@/component/card"}

const { project } = Astro.props;
---


<div class="grid grid-cols-1 md:grid-cols-2 p-8 text-white bg-[#24361C]">
<div class="p-8 ">
<img class="w-full rounded-md shadow-xl/30" src=`../images/${project?.data?.image}` />
</div>
     <div class="p-8">
       <small>{project?.data?.year}</small>
       <h2 class="orange text-4xl font-bold uppercase">{project?.data?.title}</h2>
       <h3 class="text-2xl">{project?.data?.description}</h3>

      <div class="pt-8 pb-4 max-w-lg">
      <slot />
    </div>
    <h3>Role: <span class ="orange" >{project?.data?.role}</span></h3>
    <div class="flex flex-wrap gap-2 pt-4">
      <h3>Skills Used:</h3>
      <div class="flex">
        {
           project?.data?.skills.map((item: any) => (
        
           <h3 class="orange"><span class="text-white">[</span> {item} <span class="text-white">]</span></h3>
          ))
        }
      </div>
    </div>
    <h3>Project link: <a href={project?.data?.websites} class="orange underline" target="blank">{project?.data?.websites}</a></h3>
  </div>
</div>


