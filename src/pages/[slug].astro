---
import Layout from '../layouts/Layout.astro'
import NavBar from '../component/NavBar.astro'
import Button from '../component/button/Button.astro'
import Badge from '../component/badge/Badge.astro'
import { getCollection, render } from 'astro:content';
// 1. Generate a new path for every collection entry
export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}
// 2. For your template, you can get the entry directly from the prop
const { project } = Astro.props;
const { Content } = await render(project);

---
<NavBar />
<Layout>
  <div class="mx-auto items-center">
    <div class="text-center">
    <h1 class="font-bold text-7xl mb-2">{project.data.title}</h1>
    <h3><span>Title: {project.data.title}</span>
    <span class="p-2">Year: {project.data.year.toDateString()}</span>
    </h3>
    <Button class="mt-5" href="/">Back to projects</Button>
  </div>
  
  <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
    <div class="p-8"> <img src={project.data.image} alt={project.data.title} class="object-coverw-full h-72 bg-top rounded-md shadow-md"/></div>
    <div class="p-8"> 
    <Content />
    <Button variant="warning" href="{article.data.url">More Info</Button>
  </div>
    </div>
    
      </div>
      <section class="p-4">
  <h2 class="font-bold p-4 text-1xl italic">Tags</h2>
  <div class="flex -row mx-auto items-center text-center">
      {project.data.skills.map((item: any) => (
        <Badge variant="info">
          <h3 class="p-2 text-center text-sm">{item}</h3></Badge>
      ))}
</div>
</section>
</Layout>
